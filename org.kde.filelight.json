{
    "id": "org.kde.filelight",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "filelight",
    "rename-icon": "filelight",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--filesystem=host"
    ],
    "cleanup": [
        "/share/doc",
        "/share/qlogging-categories6"
    ],
    "modules": [
        {
            "name": "filelight",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DBUILD_TESTING=OFF"
            ],
            "post-install": [
                "desktop-file-edit --set-icon=${FLATPAK_ID} ${FLATPAK_DEST}/share/applications/${FLATPAK_ID}.desktop"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.3/src/filelight-26.08.3.tar.xz",
                    "sha256": "aaf6f9d1cc91e40b37498da1dee238fd2dd0b7f4304ad8ea9a354f8760fdef44",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/filelight-$version.tar.xz"
                    }
                }
            ]
        }
    ]
}
